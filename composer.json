{
    "name": "commerce/module-admin-user-lifecycle",
    "description": "Retires dormant Magento 2 admin accounts on a schedule: warn, deactivate, then delete, with an audit journal, last-administrator protection and a dry run.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kingletas/magento2-module-foundation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kingletas/magento2-module-logger"
        }
    ],
    "require": {
        "php": ">=8.4",
        "commerce/module-foundation": "^1.0",
        "commerce/module-logger": "^2.0",
        "magento/framework": ">=103.0",
        "magento/module-authorization": ">=100.4",
        "magento/module-backend": ">=102.0",
        "magento/module-config": ">=101.2",
        "magento/module-email": ">=101.1",
        "magento/module-store": ">=101.1",
        "magento/module-user": ">=101.2"
    },
    "require-dev": {
        "magento/magento-coding-standard": ">=38 <42",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Commerce\\AdminUserLifecycle\\": ""
        },
        "exclude-from-classmap": [
            "/Test/"
        ]
    },
    "scripts": {
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
        "cs": "phpcs --standard=phpcs.xml.dist",
        "cs-fix": "phpcbf --standard=phpcs.xml.dist",
        "stan": "phpstan analyse --configuration phpstan.neon.dist --no-progress",
        "md": "phpmd Api,Console,Cron,Model text phpmd.xml.dist",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test-wiring": "phpunit --configuration phpunit.xml.dist --testsuite wiring",
        "test-behaviour": "phpunit --configuration phpunit.xml.dist --testsuite behaviour",
        "test-performance": "phpunit --configuration phpunit.xml.dist --testsuite performance",
        "test-unit": "phpunit --configuration phpunit.xml.dist --testsuite unit",
        "check": [
            "@lint",
            "@cs",
            "@stan",
            "@md",
            "@test"
        ],
        "test-integration": "phpunit --configuration phpunit.integration.xml.dist"
    },
    "suggest": {
        "magento/module-security": "Ends a retired account's live admin sessions; without it deactivation only takes effect at the next sign-in."
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/magento-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts-descriptions": {
        "check": "Everything the CI pull-request gate runs, except the integration suite.",
        "test": "Every suite this module ships. Needs M2_VENDOR pointing at a Magento installation's vendor directory.",
        "test-integration": "Integration suite. Must be run from inside a Magento installation."
    }
}
